{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Morning Loop",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["run.py", "morning"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Evening Loop",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["run.py", "evening"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Weekly Loop",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["run.py", "weekly"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Status",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["run.py", "status"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Smoke Test (mock + offline)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe run.py morning --mock --offline --force; ${workspaceFolder}/.venv/Scripts/python.exe run.py evening --mock --offline --force; ${workspaceFolder}/.venv/Scripts/python.exe run.py weekly --mock; ${workspaceFolder}/.venv/Scripts/python.exe run.py status",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "v4: Full test suite",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\python -m pytest tests/ -q" },
      "command": ".venv/bin/python -m pytest tests/ -q",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "v4: Verify DB schema (DuckDB or Neon via DATABASE_URL)",
      "detail": "Engine-agnostic: confirms the v4 migration applied cleanly and idempotently, whether running locally (DuckDB) or against DATABASE_URL (Postgres/Neon).",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\python scripts\\db_preflight.py" },
      "command": ".venv/bin/python scripts/db_preflight.py",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "v4: Selection ablation (free, uses existing history)",
      "detail": "Risk manager vs random draws from its own candidate pool. Zero API cost.",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\python run.py research" },
      "command": ".venv/bin/python run.py research",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "v4: Full research report",
      "detail": "Everything the weekly miner would be shown, rendered to the terminal.",
      "type": "shell",
      "windows": { "command": ".venv\\Scripts\\python run.py research --full" },
      "command": ".venv/bin/python run.py research --full",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
