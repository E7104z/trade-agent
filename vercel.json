{
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/cron/morning",
      "schedule": "45 10 * * 1-5"
    },
    {
      "path": "/cron/morning-continue",
      "schedule": "15 12 * * 1-5"
    },
    {
      "path": "/cron/evening",
      "schedule": "30 20 * * 1-5"
    },
    {
      "path": "/cron/runner",
      "schedule": "30 14 * * 1-5"
    },
    {
      "path": "/cron/runner-late",
      "schedule": "30 15 * * 1-5"
    },
    {
      "path": "/cron/weekly",
      "schedule": "0 14 * * 6"
    },
    {
      "path": "/cron/nightly",
      "schedule": "0 3 * * *"
    }
  ]
}
